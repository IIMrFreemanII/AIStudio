{
  "version": 1,
  "nodes": [
    { "id": "model", "type": "LoadModel", "inputs": { "path": "qwen-turbo-mlx" }, "position": { "x": 40, "y": 80 } },
    { "id": "prompt", "type": "TextEncode", "position": { "x": 320, "y": 40 },
      "inputs": { "model": { "node": "model", "output": "model" },
                  "prompt": "A red fox standing in fresh snow at sunrise, detailed fur, photograph" } },
    { "id": "latent", "type": "EmptyLatent", "inputs": { "width": 1024, "height": 1024 }, "position": { "x": 320, "y": 260 } },
    { "id": "sampler", "type": "Sampler", "position": { "x": 620, "y": 120 },
      "inputs": { "model": { "node": "model", "output": "model" },
                  "conditioning": { "node": "prompt", "output": "conditioning" },
                  "latent": { "node": "latent", "output": "latent" },
                  "seed": 1, "steps": 0 } },
    { "id": "decode", "type": "VAEDecode", "position": { "x": 900, "y": 120 },
      "inputs": { "model": { "node": "model", "output": "model" },
                  "latent": { "node": "sampler", "output": "latent" } } },
    { "id": "save", "type": "SaveImage", "position": { "x": 1160, "y": 120 },
      "inputs": { "image": { "node": "decode", "output": "image" },
                  "filename_prefix": "txt2img", "directory": "outputs" } }
  ]
}
