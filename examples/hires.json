{
  "version": 1,
  "nodes": [
    { "id": "model", "type": "LoadModel", "inputs": { "path": "qwen-turbo-mlx" }, "position": { "x": 40, "y": 140 } },
    { "id": "prompt", "type": "TextEncode", "position": { "x": 340, "y": 40 },
      "inputs": { "model": { "node": "model", "output": "model" },
                  "prompt": "A red fox standing in fresh snow at sunrise, detailed fur, photograph" } },
    { "id": "latent", "type": "EmptyLatent", "inputs": { "width": 1024, "height": 1024 }, "position": { "x": 340, "y": 300 } },
    { "id": "sampler", "type": "Sampler", "position": { "x": 640, "y": 120 },
      "inputs": { "model": { "node": "model", "output": "model" }, "conditioning": { "node": "prompt", "output": "conditioning" },
                  "latent": { "node": "latent", "output": "latent" }, "seed": 1, "steps": 0, "denoise": 1 } },
    { "id": "decode", "type": "VAEDecode", "position": { "x": 940, "y": 140 },
      "inputs": { "model": { "node": "model", "output": "model" }, "latent": { "node": "sampler", "output": "latent" } } },
    { "id": "hires_scale", "type": "ImageScale", "position": { "x": 1220, "y": 140 },
      "inputs": { "image": { "node": "decode", "output": "image" }, "factor": 1.5 } },
    { "id": "hires_encode", "type": "VAEEncode", "position": { "x": 1500, "y": 140 },
      "inputs": { "model": { "node": "model", "output": "model" }, "image": { "node": "hires_scale", "output": "image" }, "megapixels": 0 } },
    { "id": "hires_sampler", "type": "Sampler", "position": { "x": 1780, "y": 120 },
      "inputs": { "model": { "node": "model", "output": "model" }, "conditioning": { "node": "prompt", "output": "conditioning" },
                  "latent": { "node": "hires_encode", "output": "latent" }, "seed": 1, "steps": 8, "denoise": 0.4 } },
    { "id": "hires_decode", "type": "VAEDecode", "position": { "x": 2060, "y": 140 },
      "inputs": { "model": { "node": "model", "output": "model" }, "latent": { "node": "hires_sampler", "output": "latent" } } },
    { "id": "save", "type": "SaveImage", "position": { "x": 2340, "y": 140 },
      "inputs": { "image": { "node": "hires_decode", "output": "image" }, "filename_prefix": "hires", "directory": "outputs" } }
  ]
}
