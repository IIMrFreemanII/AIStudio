{
  "version": 1,
  "nodes": [
    { "id": "model", "type": "LoadModel", "inputs": { "path": "qwen-turbo-mlx" }, "position": { "x": 40, "y": 200 } },
    { "id": "image", "type": "LoadImage", "inputs": { "path": "examples/girl.png" }, "position": { "x": 40, "y": 360 } },
    { "id": "mask", "type": "LoadMask", "inputs": { "path": "examples/inpaint-mask.png", "channel": "luminance", "invert": false },
      "position": { "x": 40, "y": 500 } },
    { "id": "feather", "type": "FeatherMask", "position": { "x": 340, "y": 520 },
      "inputs": { "mask": { "node": "mask", "output": "mask" }, "grow": 0, "feather": 16 } },
    { "id": "prompt", "type": "TextEncode", "position": { "x": 340, "y": 40 },
      "inputs": { "model": { "node": "model", "output": "model" }, "image": { "node": "image", "output": "image" },
                  "prompt": "A framed oil painting of a sailboat at sea hangs on the tiled wall behind her" } },
    { "id": "encode", "type": "VAEEncode", "position": { "x": 340, "y": 320 },
      "inputs": { "model": { "node": "model", "output": "model" }, "image": { "node": "image", "output": "image" }, "megapixels": 1 } },
    { "id": "masked", "type": "SetLatentMask", "position": { "x": 640, "y": 380 },
      "inputs": { "model": { "node": "model", "output": "model" }, "latent": { "node": "encode", "output": "latent" },
                  "mask": { "node": "feather", "output": "mask" } } },
    { "id": "sampler", "type": "Sampler", "position": { "x": 940, "y": 160 },
      "inputs": { "model": { "node": "model", "output": "model" }, "conditioning": { "node": "prompt", "output": "conditioning" },
                  "latent": { "node": "masked", "output": "latent" }, "seed": 5, "steps": 0, "denoise": 1 } },
    { "id": "decode", "type": "VAEDecode", "position": { "x": 1240, "y": 200 },
      "inputs": { "model": { "node": "model", "output": "model" }, "latent": { "node": "sampler", "output": "latent" } } },
    { "id": "composite", "type": "ImageCompositeMasked", "position": { "x": 1520, "y": 280 },
      "inputs": { "destination": { "node": "image", "output": "image" }, "source": { "node": "decode", "output": "image" },
                  "mask": { "node": "feather", "output": "mask" } } },
    { "id": "save", "type": "SaveImage", "position": { "x": 1800, "y": 280 },
      "inputs": { "image": { "node": "composite", "output": "image" }, "filename_prefix": "inpaint", "directory": "outputs" } }
  ]
}
