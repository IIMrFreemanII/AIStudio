{
  "version": 1,
  "nodes": [
    { "id": "pattern", "type": "TestPattern", "inputs": { "width": 320, "height": 180, "seconds": 2, "fps": 24 },
      "position": { "x": 40, "y": 40 } },
    { "id": "tone", "type": "TestTone", "inputs": { "frequency": 440, "seconds": 3, "sample_rate": 48000, "channels": 2 },
      "position": { "x": 40, "y": 260 } },
    { "id": "low", "type": "TestTone", "inputs": { "frequency": 220, "seconds": 1, "sample_rate": 24000, "channels": 1 },
      "position": { "x": 40, "y": 440 } },
    { "id": "mix", "type": "MixAudio", "position": { "x": 340, "y": 300 },
      "inputs": { "a": { "node": "tone", "output": "audio" }, "b": { "node": "low", "output": "audio" }, "gain": 0.8, "offset": 0.5 } },
    { "id": "attach", "type": "AddAudioToVideo", "position": { "x": 640, "y": 120 },
      "inputs": { "video": { "node": "pattern", "output": "video" }, "audio": { "node": "mix", "output": "audio" },
                  "offset": 0, "gain": 1, "mode": "replace" } },
    { "id": "save_video", "type": "SaveVideo", "position": { "x": 940, "y": 100 },
      "inputs": { "video": { "node": "attach", "output": "video" }, "filename_prefix": "media-test", "directory": "outputs",
                  "format": "mp4", "codec": "h264", "quality": 0.7 } },
    { "id": "save_audio", "type": "SaveAudio", "position": { "x": 940, "y": 360 },
      "inputs": { "audio": { "node": "mix", "output": "audio" }, "filename_prefix": "media-test", "directory": "outputs",
                  "format": "m4a" } }
  ]
}
